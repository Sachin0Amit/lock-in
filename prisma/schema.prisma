// LockIn Library — Prisma schema.
//
// Two worlds live in this database:
//
//  1. The Main Academic Library — NOT stored here. It is the TypeScript
//     content registry under src/data/library/ (the single source of truth
//     for all academic content). This database never duplicates it.
//
//  2. User data for the Custom Book Builder: accounts, sessions, and the
//     per-user curated books. Custom books store ONLY references to
//     canonical library lesson ids (stable forever by the types.ts
//     contract) plus user-authored structure and reading state.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ */
/* Accounts & sessions                                                 */
/* ------------------------------------------------------------------ */

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  books    CustomBook[]
  ledger   StudyEntry[]
  attempts PracticeAttempt[]
  mistakes Mistake[]
}

/* ------------------------------------------------------------------ */
/* Revision & mastery ledger                                            */
/*                                                                      */
/* ONE study ledger per user, keyed by canonical Main Academic Library  */
/* ids (never content copies): chapters are referenced as               */
/* `${bookId}:${chapterNumber}` (the catalog key), lessons by their     */
/* stable lesson id. Every marking surface in the app (library book     */
/* page, lesson reader, custom-book reader, quizzes, the Revision Hub   */
/* session) feeds the same ledger, which drives the spaced-repetition   */
/* schedule, mastery scores, revision analytics and the knowledge       */
/* graph overlay.                                                       */
/* ------------------------------------------------------------------ */

model StudyEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "chapter" | "lesson"
  scope String
  /// chapter → `${bookId}:${chapterNumber}` · lesson → canonical lesson id
  refId String

  firstAt DateTime @default(now())
  lastAt  DateTime @default(now())
  /// total passes: the first study plus every logged revision
  passes  Int      @default(1)

  /// SM-2-lite schedule state
  ease         Float    @default(2.5)
  intervalDays Int      @default(1)
  dueAt        DateTime @default(now())
  /// last self-rating or quiz-derived quality (0..5)
  lastQuality Int      @default(3)
  /// composite mastery 0..100 (passes × recency × quality)
  mastery     Float    @default(20)
  updatedAt   DateTime @updatedAt

  events StudyEvent[]

  @@unique([userId, scope, refId])
  @@index([userId, scope])
  @@index([userId, dueAt])
}

model StudyEvent {
  id     String @id @default(cuid())
  userId String
  entry  StudyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String

  /// first | revision | quiz | chapter-mark | lesson-mark | lesson-complete
  kind    String
  /// self-rating / quiz-derived quality 0..5, when known
  quality Int?
  /// optional engagement seconds
  secs    Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entryId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/* ------------------------------------------------------------------ */
/* Practice — mock exams, adaptive drills, readiness                   */
/* ------------------------------------------------------------------ */

/// One finished practice run (a mock exam paper or an adaptive drill).
/// Stores ONLY the answers + derived scores — the questions themselves
/// are regenerated deterministically from the library via the run's
/// presetKey + seed (see src/lib/practice/engine.ts).
model PracticeAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// exam | drill
  kind      String
  /// preset key from src/data/exams/presets.ts, or "drill:auto|book:<id>|library"
  presetKey String
  /// JSON: { seed, questionIds, scopeSize, focusChapters? } — enough to
  /// rebuild the exact paper later
  meta      String   @default("{}")
  /// JSON array of per-question outcomes:
  /// [{ questionId, chosen?, selfWrong?, correct, chapterKey }]
  results   String   @default("[]")

  score     Float    @default(0)
  maxScore  Float    @default(0)
  /// seconds between start and submit (client clock, honest self-report)
  secs      Int      @default(0)

  startedAt  DateTime @default(now())
  finishedAt DateTime @default(now())

  @@index([userId, finishedAt])
}

/// The Mistake Bank: every wrong quiz answer and self-reported exercise
/// miss becomes a spaced-repetition card here, scheduled by the SAME
/// SM-2-lite engine as the study ledger (src/lib/revision/srs.ts).
/// refIds stay canonical: lessonId + a stable question key
/// (`${lessonId}#q<block>.<i>` for quiz items, `${lessonId}#x<block>.<set>.<i>`
/// for exercise questions) — shared with the practice paper generator so a
/// correct retake in the reader resolves the mistake.
model Mistake {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// quiz | exercise
  source    String
  /// canonical library lesson id
  lessonId  String
  /// stable question key (see above) — unique per user
  questionKey String

  /// snapshots for standalone review (the library stays source of truth;
  /// these are copies so the card renders without re-walking the blocks)
  prompt    String
  /// what the learner answered / "self-reported"
  given     String
  /// correct option text or final answer
  expected  String
  /// quiz explanation or exercise solution prose
  explain   String

  /// SM-2-lite schedule state (same semantics as StudyEntry)
  ease         Float    @default(2.5)
  intervalDays Int      @default(1)
  passes       Int      @default(0)
  lastQuality  Int      @default(0)
  mastery      Float    @default(0)
  lastAt       DateTime @default(now())
  dueAt        DateTime @default(now())
  /// times recorded wrong across retakes
  timesWrong  Int      @default(1)
  /// set when retired (2 consecutive good reviews, or a correct retake)
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, questionKey])
  @@index([userId, dueAt])
  @@index([userId, resolvedAt])
}

/* ------------------------------------------------------------------ */
/* Custom books                                                        */
/* ------------------------------------------------------------------ */

model CustomBook {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String   @default("")
  /// exam | subject | topics | pdf | combination
  creationMethod String
  /// JSON snapshot of the creation inputs (exam name, selections, source text…)
  inputMetadata  String   @default("{}")
  /// draft | published | archived
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chapters   CustomBookChapter[]
  items      CustomBookContentReference[]
  coverage   CustomBookCoverage[]
  bookmarks  CustomBookBookmark[]
  notes      CustomBookNote[]
  readStates CustomBookProgress[]

  @@index([userId, status])
}

model CustomBookChapter {
  id           String     @id @default(cuid())
  customBookId String
  customBook   CustomBook @relation(fields: [customBookId], references: [id], onDelete: Cascade)
  title        String
  position     Int

  items CustomBookContentReference[]

  @@index([customBookId])
}

/// One curated entry inside a custom book chapter. The academic content
/// itself is NEVER copied here — `sourceLibraryRecordId` is the canonical,
/// stable lesson id from the Main Academic Library registry.
model CustomBookContentReference {
  id                    String            @id @default(cuid())
  customBookId          String
  customBook            CustomBook        @relation(fields: [customBookId], references: [id], onDelete: Cascade)
  customBookChapterId   String
  chapter               CustomBookChapter @relation(fields: [customBookChapterId], references: [id], onDelete: Cascade)
  /// canonical lesson id from src/data/library — stable forever
  sourceLibraryRecordId String
  /// always "lesson" today; kept explicit for future record types
  sourceContentType     String            @default("lesson")
  position              Int
  /// content version hash at selection time — drift vs the live library
  /// powers "library update available" notices
  selectedVersion       String            @default("")
  /// JSON: { requestedTopic, via, confidence, requestedParent }
  matchingMetadata      String            @default("{}")

  /// a lesson appears at most once per custom book — no duplicate content
  @@unique([customBookId, sourceLibraryRecordId])
  @@index([customBookChapterId])
}

model CustomBookBookmark {
  id                    String     @id @default(cuid())
  /// owner, denormalised from the custom book — validated in the service layer
  userId                String
  customBookId          String
  customBook            CustomBook @relation(fields: [customBookId], references: [id], onDelete: Cascade)
  sourceLibraryRecordId String
  createdAt             DateTime   @default(now())

  @@unique([userId, customBookId, sourceLibraryRecordId])
}

model CustomBookNote {
  id                    String     @id @default(cuid())
  /// owner, denormalised from the custom book — validated in the service layer
  userId                String
  customBookId          String
  customBook            CustomBook @relation(fields: [customBookId], references: [id], onDelete: Cascade)
  sourceLibraryRecordId String
  noteContent           String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([customBookId, sourceLibraryRecordId])
}

model CustomBookProgress {
  id                 String     @id @default(cuid())
  /// owner, denormalised from the custom book — validated in the service layer
  userId             String
  customBookId       String
  customBook         CustomBook @relation(fields: [customBookId], references: [id], onDelete: Cascade)
  lastReadRecordId   String?
  /// JSON array of completed lesson record ids
  completedRecordIds String     @default("[]")
  updatedAt          DateTime   @updatedAt

  @@unique([userId, customBookId])
}

model CustomBookCoverage {
  id                     String     @id @default(cuid())
  customBookId           String
  customBook             CustomBook @relation(fields: [customBookId], references: [id], onDelete: Cascade)
  requestedTopic         String
  /// requested parent chapter/subject, for honest gap reporting
  requestedParent        String     @default("")
  matchedLibraryRecordId String?
  /// exact | equivalent | partial | not_available
  matchStatus            String
  matchConfidence        Float      @default(0)

  @@index([customBookId])
}
